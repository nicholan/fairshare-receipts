{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "api",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-22",
	// Uncomment once the AI extractor lands in src/extract/.
	// "ai": {
	//   "binding": "AI"
	// },
	"r2_buckets": [
		{
			"binding": "RECEIPTS",
			"bucket_name": "fairshare-receipts"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fairshare-db",
			// Replace with the id printed by `bunx wrangler d1 create fairshare-db`.
			"database_id": "00000000-0000-0000-0000-000000000000"
		}
	],
	"observability": {
		"enabled": true
	}
}
